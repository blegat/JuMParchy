+-- Omarchy disables the internal output with this flag when docked. Limit the
+-- borrowed numbering to one external display, where the destination is clear.
+local function clamshell_blocks(monitors)
+  local external = monitors[1]
+  if #monitors ~= 1 or internal(external) or external.name == "FALLBACK" then
+    return
+  end
+
+  local flag = io.open(paths.home .. "/.local/state/omarchy/toggles/hypr/internal-monitor-clamshell.lua", "r")
+  if not flag then
+    return
+  end
+  flag:close()
+
+  local file = io.open(LAPTOP_FILE, "r")
+  if file then
+    local identity = file:read("*l")
+    file:close()
+    if identity and blocks[identity] ~= nil then
+      return identity, external
+    end
+  end
+end
+
+local function overflow_slot()
+  local block = 0
+  for _, assigned in pairs(blocks) do
+    block = math.max(block, assigned + 1)
+  end
+  local id = block * SLOTS + 1
+  while hl.get_workspace(id) do
+    id = id + 1
+  end
+  return id
+end
+
+local function preserve_laptop_slots(laptop, external, by_connector, identities)
+  local block = by_connector[external.name]
+  local laptop_block = blocks[laptop]
+  local wanted = {}
+  for _, workspace in ipairs(hl.get_workspaces()) do
+    if regular(workspace) and workspace.monitor and workspace.monitor.name == external.name and workspace.windows > 0 then
+      local origin = merged[workspace.id]
+      if (origin and origin.identity == laptop) or (not origin and block_of_id(workspace.id) == laptop_block) then
+        local original_id = origin and origin.id or workspace.id
+        wanted[block * SLOTS + (original_id - 1) % SLOTS + 1] = workspace
+      end
+    end
+  end
+
+  local changed = false
+  for slot = 1, SLOTS do
+    local id = block * SLOTS + slot
+    local workspace = wanted[id]
+    local occupant = workspace and hl.get_workspace(id)
+    if occupant and workspace.id ~= id then
+      local next_id = id + 1
+      while next_id <= (block + 1) * SLOTS and (wanted[next_id] or hl.get_workspace(next_id)) do
+        next_id = next_id + 1
+      end
+      if next_id > (block + 1) * SLOTS then
+        -- Keep the overflow workspace reachable in the bar's guest section.
+        next_id = overflow_slot()
+      end
+      if not merged[id] then
+        merged[id] = { id = id, identity = identities[external.name], displaced = true }
+      end
+      renumber(occupant, next_id)
+      changed = true
+    end
+  end
+
+  for slot = 1, SLOTS do
+    local id = block * SLOTS + slot
+    local workspace = wanted[id]
+    if workspace and workspace.id ~= id then
+      if not merged[workspace.id] then
+        merged[workspace.id] = { id = workspace.id, identity = laptop }
+      end
+      renumber(workspace, id)
+      changed = true
+    end
+  end
+  return changed
+end
+
