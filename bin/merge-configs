#!/usr/bin/env bash
# Walk two config trees side by side and interactively carry changes from the
# old tree (SRC) into the new one (DST).
#
#   merge-configs ~/.config_backup.20260815-1200 ~/.config
#
# Only SRC drives the walk: anything that exists solely in DST is new material
# from the reinstall and is left alone. For every entry found in SRC:
#
#   missing in DST      ask, then copy it across (whole subtree for a directory)
#   both directories    recurse
#   identical files     ignore silently
#   differing files     show the diff, ask, then copy SRC's version over DST's
#
# Symlinks are compared as symlinks and never followed, so a file that moved
# between repo clones shows up as a difference in the link target. Decline
# those; they are reported again in the closing summary.
#
# Everything declined is listed again at the end, so nothing is silently lost.

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/lib.sh"

MAX_DIFF_LINES="${MAX_DIFF_LINES:-40}"

shopt -s dotglob nullglob

SRC="${1:-}"
DST="${2:-}"

[[ -n $SRC && -n $DST ]] || abort "usage: merge-configs SRC DST"
[[ -d $SRC ]] || abort "source $SRC is not a directory"
[[ -d $DST ]] || abort "destination $DST is not a directory"
[[ -r /dev/tty ]] || abort "merge-configs needs a terminal; run it interactively"

SRC="$(cd "$SRC" && pwd)"
DST="$(cd "$DST" && pwd)"
[[ $SRC != "$DST" ]] || abort "source and destination are the same directory"

declare -a APPLIED=()
declare -a SKIPPED=()

summary() {
  echo
  printf '\033[1m── summary ──\033[0m\n'
  printf 'applied: %d   skipped: %d\n' "${#APPLIED[@]}" "${#SKIPPED[@]}"

  if ((${#APPLIED[@]})); then
    echo
    printf '\033[1;32mCarried over from %s:\033[0m\n' "$SRC"
    printf '  %s\n' "${APPLIED[@]}"
  fi

  if ((${#SKIPPED[@]})); then
    echo
    printf '\033[1;33mLeft behind (still only in %s):\033[0m\n' "$SRC"
    printf '  %s\n' "${SKIPPED[@]}"
    echo
    echo "Re-run merge-configs to revisit them; the backup is untouched."
  fi
}

# Ask a yes/no question on the terminal. 'd' redisplays the full diff when one
# is on offer, 'q' stops the walk and jumps straight to the summary.
ask() {
  local prompt="$1" diff_src="${2:-}" diff_dst="${3:-}" reply
  local hint="[y/N/q]"
  [[ -n $diff_src ]] && hint="[y/N/d=full diff/q]"

  while true; do
    printf '\033[1;33m?\033[0m %s %s ' "$prompt" "$hint" >/dev/tty
    read -r reply </dev/tty || reply="q"
    case "${reply,,}" in
      y | yes) return 0 ;;
      "" | n | no) return 1 ;;
      d | diff)
        if [[ -n $diff_src ]]; then
          echo >/dev/tty
          diff -u "$diff_dst" "$diff_src" >/dev/tty 2>&1 || true
          echo >/dev/tty
        fi
        ;;
      q | quit)
        echo >/dev/tty
        summary
        exit 0
        ;;
    esac
  done
}

exists() {
  [[ -e $1 || -L $1 ]]
}

# Symlinks are compared as symlinks, never followed. Two links match only when
# they point at the same place, and a link never matches a regular file - so a
# file that moved between repo clones is reported rather than assumed equal.
same() {
  local a="$1" b="$2" sa sb

  if [[ -L $a || -L $b ]]; then
    if [[ -L $a && -L $b && $(readlink "$a") == "$(readlink "$b")" ]]; then
      return 0
    fi
    return 1
  fi

  sa="$(stat -c %s "$a" 2>/dev/null)" || return 1
  sb="$(stat -c %s "$b" 2>/dev/null)" || return 1
  [[ $sa == "$sb" ]] || return 1
  cmp -s "$a" "$b"
}

describe_link() {
  if [[ -L $1 ]]; then
    printf 'symlink -> %s' "$(readlink "$1")"
  else
    printf 'regular file'
  fi
}

show_diff() {
  local sp="$1" dp="$2" rel="$3" out lines

  echo
  printf '\033[1m── %s\033[0m\n' "$rel"

  if [[ -L $sp || -L $dp ]]; then
    printf '   backup:  %s\n' "$(describe_link "$sp")"
    printf '   current: %s\n' "$(describe_link "$dp")"
  fi

  out="$(diff -u "$dp" "$sp" 2>&1)" || true
  if [[ -z $out ]]; then
    if [[ -L $sp || -L $dp ]]; then
      printf '   \033[2m(same contents - only the link itself differs)\033[0m\n'
    else
      printf '   \033[2m(contents match; metadata differs)\033[0m\n'
    fi
    return
  fi

  lines="$(wc -l <<<"$out")"
  if ((lines > MAX_DIFF_LINES)); then
    head -n "$MAX_DIFF_LINES" <<<"$out"
    printf '   \033[2m… %d more lines (answer d to see all)\033[0m\n' \
      "$((lines - MAX_DIFF_LINES))"
  else
    printf '%s\n' "$out"
  fi
}

copy_over() {
  local sp="$1" dp="$2"
  mkdir -p "$(dirname "$dp")"
  # --remove-destination so a symlink in DST is replaced rather than written
  # through, which would silently edit whatever repo it points into.
  cp -a --remove-destination "$sp" "$dp"
}

walk() {
  local rel="$1" entry name srel sp dp

  for entry in "$SRC${rel:+/$rel}"/*; do
    name="$(basename "$entry")"
    srel="${rel:+$rel/}$name"
    sp="$SRC/$srel"
    dp="$DST/$srel"

    if [[ -d $sp && ! -L $sp ]]; then
      if ! exists "$dp"; then
        if ask "Directory only in backup: $srel/ — copy it across?"; then
          copy_over "$sp" "$dp"
          ok "copied $srel/"
          APPLIED+=("$srel/")
        else
          SKIPPED+=("$srel/  (whole directory)")
        fi
      elif [[ -d $dp && ! -L $dp ]]; then
        walk "$srel"
      else
        fail "$srel is a directory in the backup but not in the destination — skipping"
        SKIPPED+=("$srel  (type mismatch: directory vs file)")
      fi
      continue
    fi

    if ! exists "$dp"; then
      if ask "File only in backup: $srel — copy it across?"; then
        copy_over "$sp" "$dp"
        ok "copied $srel"
        APPLIED+=("$srel")
      else
        SKIPPED+=("$srel  (missing from destination)")
      fi
      continue
    fi

    if [[ -d $dp && ! -L $dp ]]; then
      fail "$srel is a file in the backup but a directory in the destination — skipping"
      SKIPPED+=("$srel  (type mismatch: file vs directory)")
      continue
    fi

    same "$sp" "$dp" && continue

    local reason="contents differ"
    if [[ -L $sp || -L $dp ]]; then
      if diff -q "$dp" "$sp" >/dev/null 2>&1; then
        reason="link differs, contents identical"
      else
        reason="link and contents differ"
      fi
    fi

    show_diff "$sp" "$dp" "$srel"

    if [[ -L $dp ]]; then
      printf '   \033[1;31m!\033[0m destination is a symlink into %s\n' \
        "$(dirname "$(readlink -f "$dp")")"
      printf '     Applying replaces the link with a plain file and drops it out\n'
      printf '     of config.sh management. Usually you want to edit the repo instead.\n'
    fi

    if ask "Apply the backup version of $srel?" "$sp" "$dp"; then
      copy_over "$sp" "$dp"
      ok "applied $srel"
      APPLIED+=("$srel")
    else
      SKIPPED+=("$srel  ($reason)")
    fi
  done
}

printf 'Comparing\n  backup:  %s\n  current: %s\n' "$SRC" "$DST"
echo
walk ""
summary
